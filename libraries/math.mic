// micro math library example
// by las-r

PI = 3.141592653589793
E = 2.718281828459045

func abs(x)
    if x < 0
        return -x
    end
    return x
end

func sign(x)
    if x < 0
        return -1
    end
    if x > 0
        return 1
    end
    return 0
end

func min(a, b)
    if a < b
        return a
    end
    return b
end

func max(a, b)
    if a > b
        return a
    end
    return b
end

func clamp(x, lo, hi)
    return min(max(x, lo), hi)
end

func floor(x)
    i = conv(x, "int")
    if i > x
        i = i - 1
    end
    return i
end

func ceil(x)
    i = conv(x, "int")
    if i < x
        i = i + 1
    end
    return i
end

func round(x)
    return floor(x + 0.5)
end

func pow(b, e)
    if e < 0
        return 1 / pow(b, -e)
    end
    r = 1
    while e > 0
        if e % 2 == 1
            r = r * b
        end
        b = b * b
        e = conv(e / 2, "int")
    end
    return r
end

func sqrt(x)
    if x < 0
        return -1
    end
    if x == 0
        return 0
    end
    g = x
    i = 0
    while i < 100
        g = (g + (x / g)) / 2
        i = i + 1
    end
    return g
end

func gcd(a, b)
    a = abs(a)
    b = abs(b)
    while b
        t = b
        b = a % b
        a = t
    end
    return a
end

func lcm(a, b)
    if (a == 0) || (b == 0)
        return 0
    end
    return conv(abs(a * b) / gcd(a, b), "int")
end

func fact(n)
    r = 1
    while n > 1
        r = r * n
        n = n - 1
    end
    return r
end

func isprime(n)
    if n < 2
        return 0
    end
    i = 2
    while i * i <= n
        if n % i == 0
            return 0
        end
        i = i + 1
    end
    return 1
end
